{
  "name": "anecho-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "mock": "tsx mock/server.ts",
    "check:mock": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --types node mock/server.ts mock/smoke.ts",
    "smoke:mock": "tsx mock/smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@tauri-apps/api": "^2.9.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "svelte": "^5.30.0",
    "svelte-check": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.21.3",
    "vitest": "^3.2.0"
  }
}
